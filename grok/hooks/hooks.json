{
  "description": "Register this Grok session with the local peer spool and deliver observations",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "StopCancelled": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "../bin/hook", "timeout": 20 }] }
    ]
  }
}
